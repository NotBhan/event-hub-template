---
import PublicLayout from '@/layouts/PublicLayout.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import { getOrderByReference, getOrderDetail } from '@/features/orders/service';
import { getEventJoinInstructions } from '@/features/events/service';
import { ticketQrSvg } from '@/features/tickets/qr';
import { assertRegistrationAccess } from '@/lib/security/registration-access';
import { formatEventWindow, ORDER_STATUS_LABELS } from '@/lib/format';
import { formatMoney } from '@/lib/money';
import { HttpError } from '@/lib/security/errors';

/**
 * A buyer's registration and tickets.
 *
 * Access is granted by the key in the confirmation email or by the first-party
 * cookie set at checkout — never by knowing the reference. The reference is shown
 * for support conversations, but on its own it opens nothing.
 */
const { reference } = Astro.params;

const key = Astro.url.searchParams.get('key');
const order = reference ? await getOrderByReference(reference) : undefined;

if (!order) {
  return Astro.redirect('/404', 302);
}

let accessDenied = false;

try {
  assertRegistrationAccess({
    cookies: Astro.cookies,
    order,
    key,
    viewerUserId: Astro.locals.user?.id ?? null,
    orderUserId: order.userId,
  });
} catch (error) {
  if (error instanceof HttpError && error.status === 403) accessDenied = true;
  else throw error;
}

if (accessDenied) {
  return new Response(null, {
    status: 403,
    headers: { 'content-type': 'text/plain' },
  });
}

const detail = await getOrderDetail(order.id);
if (!detail) {
  return Astro.redirect('/404', 302);
}

const when = formatEventWindow(detail.event.startsAt, detail.event.endsAt, detail.event.timezone);
const isConfirmed = order.status === 'confirmed';

const issuedTickets = detail.attendees.filter((attendee) => attendee.ticketId);

// The QR code is only rendered for tickets that are actually valid.
const qrByTicketId = new Map<string, string>();
if (isConfirmed) {
  for (const attendee of issuedTickets) {
    if (attendee.ticketId && attendee.ticketStatus === 'issued') {
      qrByTicketId.set(attendee.ticketId, await ticketQrSvg(attendee.ticketId, { width: 320 }));
    }
  }
}

// Online joining instructions are released only to a confirmed registration.
const join =
  isConfirmed && (detail.event.format === 'online' || detail.event.format === 'hybrid')
    ? await getEventJoinInstructions(detail.event.id)
    : null;
---

<PublicLayout title={`Registration ${order.publicReference}`} noIndex>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <h1 class="display display-lg text-[var(--color-ink)]">
          {isConfirmed ? 'Your tickets' : 'Your registration'}
        </h1>
        <p class="mt-1 text-sm text-[var(--color-ink-muted)]">{order.publicReference}</p>
      </div>
      <StatusBadge
        label={ORDER_STATUS_LABELS[order.status] ?? order.status}
        status={order.status}
      />
    </div>

    <section class="card mt-6 p-5">
      <h2 class="text-lg font-semibold">{detail.event.title}</h2>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">{when}</p>
      <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-muted)]">
            Registered to
          </dt>
          <dd class="mt-0.5">{order.buyerName}</dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-muted)]">
            Tickets
          </dt>
          <dd class="mt-0.5">{issuedTickets.length}</dd>
        </div>
        {order.totalMinor > 0 && (
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--color-ink-muted)]">
              Paid
            </dt>
            <dd class="mt-0.5">{formatMoney(order.totalMinor, order.currency)}</dd>
          </div>
        )}
      </dl>
    </section>

    {!isConfirmed && (
      <section class="card mt-6 p-5">
        <p class="font-medium">
          {order.status === 'pending_payment'
            ? 'This registration is awaiting payment.'
            : order.status === 'expired'
              ? 'This registration expired before payment was completed.'
              : 'This registration was cancelled.'}
        </p>
        <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
          Tickets are issued once payment is confirmed.
        </p>
        {order.status === 'pending_payment' && (
          <a href={`/checkout/${order.id}`} class="btn btn-primary btn-sm mt-4">
            Complete payment
          </a>
        )}
      </section>
    )}

    {join && (
      <section class="card mt-6 border-sky-200 bg-sky-50 p-5">
        <h2 class="text-lg font-semibold text-sky-900">Joining instructions</h2>
        <p class="mt-1 text-sm text-sky-900">{join.platform}</p>
        {join.joinUrl && (
          <a href={join.joinUrl} class="btn btn-primary btn-sm mt-3" rel="noreferrer noopener">
            Join the event
          </a>
        )}
        {join.accessInstructions && (
          <p class="mt-3 whitespace-pre-line text-sm text-sky-900">{join.accessInstructions}</p>
        )}
        <p class="mt-3 text-xs text-sky-900">
          This link is private to confirmed attendees. Please do not share it publicly.
        </p>
      </section>
    )}

    <section class="mt-8">
      <h2 class="text-lg font-semibold">{issuedTickets.length === 1 ? 'Ticket' : 'Tickets'}</h2>

      {issuedTickets.length === 0 ? (
        <p class="card mt-3 p-5 text-sm text-[var(--color-ink-muted)]">
          No tickets have been issued yet.
        </p>
      ) : (
        <ul class="mt-3 space-y-5">
          {detail.attendees.map((attendee) => (
            <li class="card overflow-hidden">
              <div class="flex flex-wrap items-start justify-between gap-2 border-b border-[var(--color-line)] p-4">
                <div>
                  <p class="font-semibold">{attendee.name}</p>
                  <p class="text-sm text-[var(--color-ink-muted)]">{attendee.ticketTypeName}</p>
                  <p class="mt-1 text-xs text-[var(--color-ink-muted)]">{attendee.email}</p>
                </div>
                <div class="text-right">
                  <StatusBadge
                    label={attendee.ticketStatus === 'void' ? 'Void' : 'Valid'}
                    status={attendee.ticketStatus ?? 'issued'}
                  />
                  <p class="mt-1 font-mono text-xs text-[var(--color-ink-muted)]">
                    {attendee.ticketReference ?? '—'}
                  </p>
                </div>
              </div>

              {attendee.ticketId && qrByTicketId.has(attendee.ticketId) ? (
                <div class="flex flex-col items-center gap-3 p-5">
                  <div
                    class="w-full max-w-[260px] [&>svg]:h-auto [&>svg]:w-full"
                    aria-hidden="true"
                    set:html={qrByTicketId.get(attendee.ticketId)}
                  />
                  <p class="text-center text-xs text-[var(--color-ink-muted)]">
                    Present this code at the entrance. It admits one person, once.
                  </p>
                </div>
              ) : (
                <p class="p-5 text-sm text-[var(--color-ink-muted)]">
                  {attendee.ticketStatus === 'void'
                    ? 'This ticket has been voided and will not be admitted.'
                    : 'The QR code appears here once the ticket is issued.'}
                </p>
              )}
            </li>
          ))}
        </ul>
      )}
    </section>

    <section class="card mt-8 p-5">
      <h2 class="text-base font-semibold">Order summary</h2>
      <table class="data-table mt-3">
        <thead>
          <tr>
            <th scope="col">Ticket</th>
            <th scope="col" class="text-center">
              Qty
            </th>
            <th scope="col" class="text-right">
              Amount
            </th>
          </tr>
        </thead>
        <tbody>
          {detail.items.map((item) => (
            <tr>
              <td>{item.ticketNameSnapshot}</td>
              <td class="text-center">{item.quantity}</td>
              <td class="text-right">{formatMoney(item.lineTotalMinor, item.currency)}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-3 text-xs text-[var(--color-ink-muted)]">
        Keep this link — it is how you return to your tickets. Need help? Contact the organizer
        quoting {order.publicReference}.
      </p>
    </section>
  </div>
</PublicLayout>
