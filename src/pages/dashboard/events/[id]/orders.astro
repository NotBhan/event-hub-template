---
import { actions } from 'astro:actions';
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import StatusBadge from '@/components/ui/StatusBadge.astro';
import { organizerGuard } from '@/lib/permissions/page-guards';
import { can } from '@/lib/permissions/guards';
import { getEventForOrganization } from '@/features/events/service';
import { listOrders } from '@/features/orders/service';
import {
  refundableBalance,
  listRefundableTickets,
  listRefundsForOrder,
} from '@/features/refunds/service';
import { getLatestPayment } from '@/features/orders/service';
import { db } from '@/lib/db/client';
import {
  ORDER_STATUS_LABELS,
  PAYMENT_STATUS_LABELS,
  REFUND_STATUS_LABELS,
  formatCompactWindow,
} from '@/lib/format';
import { formatMoney, toMajorUnits } from '@/lib/money';

/**
 * Orders for an event, with the refund workflow.
 *
 * The refundable balance shown here is informational: `requestRefund` re-reads it
 * under a row lock before accepting anything, because two staff members looking at
 * the same screen must not be able to refund the same money twice.
 */
const guard = organizerGuard(Astro);
if (!guard.ok) return Astro.redirect(guard.redirectTo ?? '/dashboard/no-access', 302);

const { membership } = guard;
const eventId = Astro.params.id;

if (!eventId) return Astro.redirect('/dashboard/events', 302);

let event;
try {
  event = await getEventForOrganization(eventId, membership.organizationId);
} catch {
  return Astro.redirect('/dashboard/events', 302);
}

const search = Astro.url.searchParams.get('q')?.trim() ?? '';
const statusParam = Astro.url.searchParams.get('status')?.trim() ?? '';

const status =
  statusParam === 'pending_payment' ||
  statusParam === 'confirmed' ||
  statusParam === 'expired' ||
  statusParam === 'cancelled'
    ? statusParam
    : undefined;

const { rows, total } = await listOrders({
  organizationId: membership.organizationId,
  eventId: event.id,
  search: search || undefined,
  status,
  limit: 25,
});

const canRefund = can(Astro, { refund: ['create'] });
const canSeeMoney = can(Astro, { payment: ['read'] });

/** Refund detail is only loaded for orders that could actually be refunded. */
const details = new Map<
  string,
  {
    payment: Awaited<ReturnType<typeof getLatestPayment>>;
    balance: Awaited<ReturnType<typeof refundableBalance>> | null;
    tickets: Awaited<ReturnType<typeof listRefundableTickets>>;
    refunds: Awaited<ReturnType<typeof listRefundsForOrder>>;
  }
>();

if (canRefund) {
  for (const order of rows) {
    if (order.status !== 'confirmed') continue;

    const payment = await getLatestPayment(order.id);

    details.set(order.id, {
      payment,
      balance: payment ? await refundableBalance(db(), payment.id).catch(() => null) : null,
      tickets: await listRefundableTickets(order.id),
      refunds: await listRefundsForOrder(order.id),
    });
  }
}

const refundResult = Astro.getActionResult(actions.requestRefund);
---

<DashboardLayout
  title={`Orders · ${event.title}`}
  description="Orders and refunds"
  section="events"
>
  <nav class="mb-6 text-sm" aria-label="Breadcrumb">
    <a href="/dashboard/events" class="text-[var(--color-ink-muted)] hover:underline">
      Events
    </a>
    <span class="text-[var(--color-ink-muted)]"> / </span>
    <a href={`/dashboard/events/${event.id}`} class="text-[var(--color-ink-muted)] hover:underline">
      {event.title}
    </a>
    <span class="text-[var(--color-ink-muted)]"> / </span>
    <span class="text-[var(--color-ink-muted)]">Orders</span>
  </nav>

  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Orders</h1>
      <p class="mt-1 text-sm text-[var(--color-ink-muted)]">
        {total}
        {total === 1 ? 'order' : 'orders'} · {formatCompactWindow(event.startsAt, event.timezone)}
      </p>
    </div>
    <a href={`/dashboard/events/${event.id}/attendees`} class="btn btn-secondary btn-sm">
      Attendees
    </a>
  </div>

  {refundResult?.data && (
    <p
      class:list={[
        'mb-6 rounded-[var(--radius-card)] border p-3 text-sm',
        refundResult.data.ok
          ? 'border-emerald-200 bg-emerald-50 text-emerald-900'
          : 'border-red-200 bg-red-50 text-red-800',
      ]}
    >
      {refundResult.data.ok
        ? refundResult.data.message
        : (refundResult.data.fieldErrors?._form ?? 'The refund could not be processed.')}
    </p>
  )}

  <form method="GET" class="card mb-6 p-4">
    <div class="grid gap-3 sm:grid-cols-[1fr_auto_auto]">
      <div>
        <label class="label" for="q">
          Search
        </label>
        <input
          id="q"
          name="q"
          type="search"
          class="input"
          placeholder="Buyer, email or reference"
          value={search}
        />
      </div>
      <div class="sm:w-44">
        <label class="label" for="status">
          Status
        </label>
        <select id="status" name="status" class="input">
          <option value="">All</option>
          {Object.entries(ORDER_STATUS_LABELS).map(([value, label]) => (
            <option value={value} selected={value === status}>
              {label}
            </option>
          ))}
        </select>
      </div>
      <div class="flex items-end gap-2">
        <button type="submit" class="btn btn-secondary btn-sm">
          Filter
        </button>
        <a href="?" class="btn btn-ghost btn-sm">
          Clear
        </a>
      </div>
    </div>
  </form>

  {rows.length === 0 ? (
    <p class="card p-8 text-center text-sm text-[var(--color-ink-muted)]">
      {search || status ? 'No orders match those filters.' : 'No orders yet.'}
    </p>
  ) : (
    <ul class="space-y-4">
      {rows.map((order) => {
        const detail = details.get(order.id);
        const balance = detail?.balance;
        const hasRefunds = (detail?.refunds.length ?? 0) > 0;

        return (
          <li class="card p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="font-mono text-xs text-[var(--color-ink-muted)]">
                  {order.publicReference}
                </p>
                <p class="mt-1 font-semibold">{order.buyerName}</p>
                <p class="text-sm text-[var(--color-ink-muted)]">{order.buyerEmail}</p>
                {order.buyerPhone && (
                  <p class="text-sm text-[var(--color-ink-muted)]">{order.buyerPhone}</p>
                )}
              </div>

              <div class="text-right">
                <p class="text-lg font-semibold">{formatMoney(order.totalMinor, order.currency)}</p>
                <p class="mt-1 flex flex-wrap justify-end gap-1">
                  <StatusBadge
                    label={ORDER_STATUS_LABELS[order.status] ?? order.status}
                    status={order.status}
                  />
                  {order.paymentStatus && (
                    <StatusBadge
                      label={PAYMENT_STATUS_LABELS[order.paymentStatus] ?? order.paymentStatus}
                      status={order.paymentStatus}
                    />
                  )}
                </p>
                <p class="mt-1 text-xs text-[var(--color-ink-muted)]">
                  {order.attendeeCount} attendee{order.attendeeCount === 1 ? '' : 's'}
                </p>
              </div>
            </div>

            {hasRefunds && (
              <ul class="mt-4 space-y-1 text-sm">
                {detail?.refunds.map((refund) => (
                  <li class="flex flex-wrap items-center gap-2 text-[var(--color-ink-muted)]">
                    <StatusBadge
                      label={REFUND_STATUS_LABELS[refund.status] ?? refund.status}
                      status={refund.status}
                    />
                    <span>{formatMoney(refund.amountMinor, refund.currency)}</span>
                    {refund.reason && <span>· {refund.reason}</span>}
                    {refund.failureReason && (
                      <span class="text-red-700">· {refund.failureReason}</span>
                    )}
                  </li>
                ))}
              </ul>
            )}

            {canRefund &&
              order.status === 'confirmed' &&
              balance &&
              balance.refundableMinor > 0 && (
                <details class="mt-4 border-t border-[var(--color-line)] pt-4">
                  <summary class="cursor-pointer text-sm font-medium">Issue a refund</summary>

                  <p class="mt-3 text-sm text-[var(--color-ink-muted)]">
                    Up to {formatMoney(balance.refundableMinor, balance.currency)} remains
                    refundable
                    {balance.alreadyRefundedMinor > 0 &&
                      ` (already refunded ${formatMoney(balance.alreadyRefundedMinor, balance.currency)})`}
                    .
                  </p>

                  <form method="POST" action={actions.requestRefund} class="mt-4 space-y-4">
                    <input type="hidden" name="orderId" value={order.id} />

                    <div>
                      <label class="label" for={`reason-${order.id}`}>
                        Reason
                      </label>
                      <input
                        id={`reason-${order.id}`}
                        name="reason"
                        class="input"
                        required
                        maxlength="500"
                        placeholder="Attendee cannot attend"
                      />
                    </div>

                    <div>
                      <label class="label" for={`amount-${order.id}`}>
                        Amount ({balance.currency}) — leave blank to refund everything refundable
                      </label>
                      <input
                        id={`amount-${order.id}`}
                        name="amount"
                        type="number"
                        step="0.01"
                        min="0"
                        max={toMajorUnits(balance.refundableMinor, balance.currency)}
                        class="input"
                        placeholder={toMajorUnits(
                          balance.refundableMinor,
                          balance.currency,
                        ).toFixed(2)}
                      />
                    </div>

                    {detail && detail.tickets.length > 0 && (
                      <fieldset>
                        <legend class="label">
                          Specific tickets (leave empty to refund the whole order)
                        </legend>
                        <ul class="mt-1 space-y-1.5">
                          {detail.tickets.map((ticket) => (
                            <li class="flex items-center gap-2">
                              <input
                                id={`ticket-${ticket.ticketId}`}
                                type="checkbox"
                                name="ticketIds"
                                value={ticket.ticketId}
                                class="h-4 w-4"
                              />
                              <label for={`ticket-${ticket.ticketId}`} class="text-sm">
                                {ticket.attendeeName} — {ticket.ticketTypeName} (
                                {formatMoney(ticket.priceMinor, ticket.currency)}){' '}
                                <span class="font-mono text-xs text-[var(--color-ink-muted)]">
                                  {ticket.publicReference}
                                </span>
                              </label>
                            </li>
                          ))}
                        </ul>
                        <p class="help-text">
                          Refunded tickets are voided. A ticket that has already been admitted
                          cannot be voided, so the refund is recorded and flagged for review
                          instead.
                        </p>
                      </fieldset>
                    )}

                    <div>
                      <label class="label" for={`notes-${order.id}`}>
                        Internal note <span class="font-normal">(optional)</span>
                      </label>
                      <input id={`notes-${order.id}`} name="notes" class="input" maxlength="2000" />
                    </div>

                    <button type="submit" class="btn btn-danger btn-sm">
                      Submit refund
                    </button>
                  </form>
                </details>
              )}

            {canSeeMoney &&
              order.status === 'confirmed' &&
              balance &&
              balance.refundableMinor <= 0 && (
                <p class="mt-4 border-t border-[var(--color-line)] pt-3 text-sm text-[var(--color-ink-muted)]">
                  Fully refunded.
                </p>
              )}
          </li>
        );
      })}
    </ul>
  )}
</DashboardLayout>
