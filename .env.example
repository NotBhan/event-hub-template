# ---------------------------------------------------------------------------
# Deployment configuration.
#
# Copy to `.env` and fill in real values. Never commit `.env` itself.
# These values are deployment-specific and must differ for every client.
#
# On Vercel these are set in Project → Settings → Environment Variables instead
# of a file. The application chooses its adapter automatically from `VERCEL=1`,
# and derives its canonical URL from the platform's own domain variables.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4321

# Public origin of this deployment. Used for canonical URLs, payment callbacks
# and email links. Must match the domain users actually visit.
PUBLIC_SITE_URL=http://localhost:4321

# --- Database ----------------------------------------------------------------
# Runtime application account: least privilege, no DDL rights.
DATABASE_URL=postgres://event_app:event_app_password@localhost:5432/event_platform

# Migration account: owns the schema and applies versioned migrations.
# Falls back to DATABASE_URL when unset (single-account development setups).
# DATABASE_MIGRATION_URL=postgres://event_owner:event_owner_password@localhost:5432/event_platform
#
# On Neon these two are the same database through different endpoints: the app
# uses the pooled (`-pooler`) URL, because a serverless deployment opens many
# short-lived connections, while Drizzle Kit migrates through the unpooled URL,
# because PgBouncer will not carry schema changes. `neon init` writes both.
# DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
# DATABASE_MIGRATION_URL=$DATABASE_URL_UNPOOLED

# --- Object storage ----------------------------------------------------------
# Cover image uploads. Neon Object Storage speaks the S3 API, and these are the
# AWS-standard names on purpose: the SDK resolves credentials, endpoint and
# region from the environment by itself. `neon deploy` pulls all four.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
# AWS_REGION=

# Bucket for uploaded artwork. Optional: `assets` is the default.
S3_BUCKET=assets

# --- Neon Auth -----------------------------------------------------------------
# Endpoints for this Neon branch, from `neon env pull`. The application signs
# users in with Better Auth against its own tables; these are here for anything
# that needs to verify Neon-issued tokens.
# NEON_AUTH_URL=
# NEON_AUTH_JWKS_URL=

# --- Authentication ----------------------------------------------------------
# Must be at least 32 characters. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=replace-me-with-a-long-random-secret-value
BETTER_AUTH_URL=http://localhost:4321

# Keys ticket QR credentials. Must be at least 32 characters and MUST be
# different from BETTER_AUTH_SECRET. Keep it out of database backups: a leaked
# database alone must never allow a ticket to be forged.
# Generate with: openssl rand -base64 48
TICKET_TOKEN_SECRET=replace-me-with-a-different-long-random-secret

# --- Payments ----------------------------------------------------------------
# `razorpay` for a real integration, `simulated` for a clearly labelled local
# demo checkout that never touches a real gateway.
#
# The simulated provider is refused when NODE_ENV=production. A hosted demo
# (for example on Vercel, which sets NODE_ENV=production) must opt in explicitly
# below. Never enable this on a deployment that sells real tickets.
PAYMENT_PROVIDER=simulated
ALLOW_SIMULATED_PAYMENTS=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------------
# `console` logs rendered messages instead of sending them (development only).
EMAIL_PROVIDER=console
EMAIL_FROM="Event Hub <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Operational -------------------------------------------------------------
# How long an unpaid order holds reserved inventory before it expires.
ORDER_RESERVATION_MINUTES=30

# Initial organization created by `npm run provision`.
PROVISION_ORG_NAME=Event Hub
PROVISION_ORG_SLUG=event-hub
PROVISION_OWNER_EMAIL=owner@example.com
